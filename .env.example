# ==========================================
# PostgreSQL
# ==========================================
DB_NAME=postify
DB_USER=postify_user
DB_PASSWORD=change_me_please

# ==========================================
# MinIO (Object Storage)
# ==========================================
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_USER=minioadmin
OBJECT_STORAGE_PASSWORD=minioadmin123
OBJECT_STORAGE_BUCKET=postify-files

# ==========================================
# Session Security (JWT / Auth)
# ==========================================
SESSION_SECRET_KEY=generate_strong_secret_here_32_chars_min
SESSION_EXPIRATION=1h
SESSION_REFRESH_EXPIRATION=30d

# ==========================================
# Session Cleanup
# ==========================================
SESSION_CLEANUP_DELAY=5m
SESSION_CLEANUP_SIZE=10000

# ==========================================
# Views (Read Tracking) Cleanup
# ==========================================
VIEWS_EXPIRATION=24h
VIEWS_CLEANUP_DELAY=1h
VIEWS_CLEANUP_SIZE=10000

# ==========================================
# Spring / App Settings
# ==========================================
SPRING_PROFILES_ACTIVE=docker
SPRING_FLYWAY_ENABLED=true
SPRING_LOGGING_LEVEL_ROOT=INFO
SPRING_LOGGING_LEVEL_APP=DEBUG

# ==========================================
# Optional: Override Hikari Connection Pool
# ==========================================
# SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
# SPRING_DATASOURCE_HIKARI_MAX_POOL=10